<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Preventiva de Frota</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #12161c;
    --surface: #1a2029;
    --surface-2: #212936;
    --line: #2a3242;
    --text: #eef1f5;
    --text-dim: #8b96a8;
    --ok: #3fb68a;
    --warn: #e8a33d;
    --late: #e5484d;
    --accent: #5b8def;
    --radius: 14px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'Inter', sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:520px; margin:0 auto; padding:0 0 48px;}

  header.top{
    padding:28px 20px 20px;
    border-bottom:1px solid var(--line);
    background: linear-gradient(180deg, #171d26 0%, var(--bg) 100%);
  }
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--accent); margin:0 0 6px;
  }
  h1{
    font-family:'Space Grotesk', sans-serif;
    font-size:26px; margin:0; letter-spacing:-0.01em;
  }

  .tabs{
    display:flex; gap:8px; padding:16px 20px 0;
  }
  .tab{
    flex:1; text-align:center; padding:10px 8px;
    font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:.06em;
    text-transform:uppercase; color:var(--text-dim);
    background:var(--surface); border:1px solid var(--line);
    border-radius:10px; cursor:pointer; transition:.15s;
  }
  .tab.active{ color:var(--bg); background:var(--accent); border-color:var(--accent); font-weight:600;}

  section.panel{ padding:20px; display:none;}
  section.panel.active{ display:block;}

  .card{
    background:var(--surface); border:1px solid var(--line);
    border-radius:var(--radius); padding:18px; margin-bottom:16px;
  }
  .card h2{
    font-family:'Space Grotesk', sans-serif; font-size:15px; margin:0 0 14px;
    display:flex; align-items:center; gap:8px;
  }

  label{ display:block; font-size:12px; color:var(--text-dim); margin:12px 0 6px; font-weight:500;}
  input, select{
    width:100%; padding:12px 14px; border-radius:10px;
    border:1px solid var(--line); background:var(--surface-2); color:var(--text);
    font-size:15px; font-family:'Inter', sans-serif;
  }
  input:focus, select:focus{ outline:none; border-color:var(--accent); }
  input[type="date"]{ color-scheme: dark; }

  button.btn{
    width:100%; margin-top:18px; padding:14px; border:none; border-radius:10px;
    background:var(--accent); color:#0b1220; font-weight:700; font-size:14px;
    cursor:pointer; letter-spacing:.02em; transition:.15s;
  }
  button.btn:active{ transform:scale(.98); }
  button.btn:disabled{ opacity:.5; }
  button.btn.secondary{ background:var(--surface-2); color:var(--text); border:1px solid var(--line); }

  .msg{ font-size:13px; margin-top:10px; padding:10px 12px; border-radius:8px; display:none; }
  .msg.show{ display:block; }
  .msg.ok{ background:rgba(63,182,138,.12); color:var(--ok); }
  .msg.err{ background:rgba(229,72,77,.12); color:var(--late); }

  .fleet-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:13px 14px; border-radius:10px; background:var(--surface-2);
    margin-bottom:8px; border-left:3px solid var(--line);
  }
  .fleet-row.ok{ border-left-color:var(--ok); }
  .fleet-row.warn{ border-left-color:var(--warn); }
  .fleet-row.late{ border-left-color:var(--late); }
  .placa{ font-family:'JetBrains Mono', monospace; font-weight:700; font-size:15px; }
  .fleet-meta{ font-size:11px; color:var(--text-dim); margin-top:2px; }
  .dot{ width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:6px;}
  .dot.ok{ background:var(--ok);} .dot.warn{ background:var(--warn);} .dot.late{ background:var(--late);}
  .faltam{ font-family:'JetBrains Mono', monospace; font-size:13px; text-align:right;}

  .empty{ text-align:center; color:var(--text-dim); font-size:13px; padding:24px 0;}

  .login-box{ text-align:center; padding:40px 0; }
  .login-box p{ color:var(--text-dim); font-size:13px; margin-bottom:20px;}

  .stat-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:6px;}
  .stat{ background:var(--surface-2); border-radius:10px; padding:14px 8px; text-align:center;}
  .stat .num{ font-family:'JetBrains Mono', monospace; font-size:22px; font-weight:700;}
  .stat .lbl{ font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.05em; margin-top:4px;}
  .stat.ok .num{ color:var(--ok);} .stat.warn .num{ color:var(--warn);} .stat.late .num{ color:var(--late);}

  .bar-row{ margin-bottom:10px; }
  .bar-row .bar-label{ display:flex; justify-content:space-between; font-size:12px; color:var(--text-dim); margin-bottom:4px;}
  .bar-track{ height:8px; background:var(--surface-2); border-radius:4px; overflow:hidden;}
  .bar-fill{ height:100%; border-radius:4px; }

  .refresh-link{ text-align:center; font-size:12px; color:var(--text-dim); margin-top:14px; cursor:pointer; text-decoration:underline;}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <p class="eyebrow">J&amp;T · Frota</p>
    <h1>Preventiva de KM</h1>
  </header>

  <div class="tabs">
    <div class="tab active" data-tab="mecanica">Mecânica</div>
    <div class="tab" data-tab="adm">ADM</div>
  </div>

  <!-- ===================== ÁREA MECÂNICA ===================== -->
  <section class="panel active" id="panel-mecanica">

    <div class="card">
      <h2>Lançar preventiva</h2>
      <label for="m-placa">Placa</label>
      <input id="m-placa" type="text" placeholder="Ex: ABC1D23" autocapitalize="characters" maxlength="8">
      <label for="m-data">Data</label>
      <input id="m-data" type="date">
      <label for="m-km">KM da troca</label>
      <input id="m-km" type="number" inputmode="numeric" placeholder="Ex: 152300">
      <label for="m-tipo">Tipo de troca</label>
      <input id="m-tipo" type="text" placeholder="Ex: TROCA DE ÓLEO" style="text-transform:uppercase;">
      <button class="btn" id="btn-lancar">Lançar</button>
      <div class="msg" id="msg-lancar"></div>
    </div>

    <div class="card">
      <h2>Status da frota</h2>
      <div id="fleet-list"><div class="empty">Carregando…</div></div>
      <div class="refresh-link" id="refresh-fleet">atualizar lista</div>
    </div>

  </section>

  <!-- ===================== ÁREA ADM ===================== -->
  <section class="panel" id="panel-adm">

    <div class="card login-box" id="adm-login">
      <h2 style="justify-content:center">Área restrita</h2>
      <p>Digite a senha da equipe ADM</p>
      <input id="adm-senha" type="password" placeholder="Senha" style="max-width:220px; margin:0 auto 14px; display:block;">
      <button class="btn" id="btn-adm-login" style="max-width:220px; margin:0 auto;">Entrar</button>
      <div class="msg" id="msg-adm-login"></div>
    </div>

    <div id="adm-content" style="display:none;">

      <div class="card">
        <h2>Resumo</h2>
        <div class="stat-grid" id="adm-stats">
          <div class="stat ok"><div class="num">–</div><div class="lbl">OK</div></div>
          <div class="stat warn"><div class="num">–</div><div class="lbl">Perto</div></div>
          <div class="stat late"><div class="num">–</div><div class="lbl">Vencida</div></div>
        </div>
        <div style="margin-top:16px;" id="adm-bars"></div>
      </div>

      <div class="card">
        <h2>Atualizar KM atual</h2>
        <label for="a-placa">Placa</label>
        <input id="a-placa" type="text" placeholder="Ex: ABC1D23" autocapitalize="characters" maxlength="8">
        <label for="a-km">KM atual</label>
        <input id="a-km" type="number" inputmode="numeric" placeholder="Ex: 158900">
        <button class="btn" id="btn-atualizar-km">Atualizar</button>
        <div class="msg" id="msg-atualizar-km"></div>
      </div>

    </div>
  </section>

</div>

<script>
/* =========================================================
   CONFIGURAÇÃO
   Troque pela URL do seu Worker publicado no Cloudflare.
   Ex: https://preventiva-frota.SEU-USUARIO.workers.dev
========================================================= */
const WORKER_URL = "https://curly-voice-6d40preventiva-frota.jtassistentetransporte.workers.dev";

let admSenha = null;

// ---------- Tabs ----------
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
    if(tab.dataset.tab === 'mecanica') loadFleet();
  });
});

// ---------- Helpers ----------
function showMsg(el, text, ok){
  el.textContent = text;
  el.className = 'msg show ' + (ok ? 'ok' : 'err');
}
function statusClass(status){
  if(status === 'Vencida') return 'late';
  if(status === 'Perto de vencer') return 'warn';
  return 'ok';
}
function fmtNum(n){
  return Number(n||0).toLocaleString('pt-BR');
}
// Aceita placa padrão antigo (ABC1234) e padrão Mercosul (ABC1D23)
const PLACA_REGEX = /^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$/;
function placaValida(placa){
  return PLACA_REGEX.test(placa);
}
async function api(path, opts){
  const res = await fetch(WORKER_URL + path, opts);
  const data = await res.json().catch(()=>({}));
  if(!res.ok) throw new Error(data.error || 'Erro na requisição');
  return data;
}

// ---------- Mecânica: lançar ----------
document.getElementById('btn-lancar').addEventListener('click', async ()=>{
  const placa = document.getElementById('m-placa').value.trim().toUpperCase();
  const data = document.getElementById('m-data').value;
  const km = document.getElementById('m-km').value;
  const tipo = document.getElementById('m-tipo').value.trim().toUpperCase();
  const msg = document.getElementById('msg-lancar');
  const btn = document.getElementById('btn-lancar');

  if(!placa || !data || !km || !tipo){
    showMsg(msg, 'Preenche placa, data, KM e tipo de troca.', false);
    return;
  }
  if(!placaValida(placa)){
    showMsg(msg, 'Placa inválida. Use o formato ABC1234 ou ABC1D23.', false);
    return;
  }
  btn.disabled = true; btn.textContent = 'Enviando…';
  try{
    await api('/api/lancar', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({placa, data, km: Number(km), tipo})
    });
    showMsg(msg, 'Preventiva lançada com sucesso.', true);
    document.getElementById('m-placa').value = '';
    document.getElementById('m-km').value = '';
    document.getElementById('m-tipo').value = '';
    loadFleet();
  }catch(e){
    showMsg(msg, 'Não deu pra lançar: ' + e.message, false);
  }finally{
    btn.disabled = false; btn.textContent = 'Lançar';
  }
});

// ---------- Mecânica: status da frota ----------
async function loadFleet(){
  const box = document.getElementById('fleet-list');
  box.innerHTML = '<div class="empty">Carregando…</div>';
  try{
    const data = await api('/api/status');
    const items = data.frota || [];
    if(items.length === 0){
      box.innerHTML = '<div class="empty">Nenhuma placa cadastrada ainda.</div>';
      return;
    }
    box.innerHTML = items.map(v=>{
      const cls = statusClass(v.status);
      return `<div class="fleet-row ${cls}">
        <div>
          <div class="placa">${v.placa}</div>
          <div class="fleet-meta"><span class="dot ${cls}"></span>${v.status}</div>
        </div>
        <div class="faltam">${v.faltam >= 0 ? fmtNum(v.faltam)+' km' : 'vencida'}</div>
      </div>`;
    }).join('');
  }catch(e){
    box.innerHTML = '<div class="empty">Erro ao carregar: '+e.message+'</div>';
  }
}
document.getElementById('refresh-fleet').addEventListener('click', loadFleet);
loadFleet();

// ---------- ADM: login ----------
document.getElementById('btn-adm-login').addEventListener('click', async ()=>{
  const senha = document.getElementById('adm-senha').value;
  const msg = document.getElementById('msg-adm-login');
  try{
    await api('/api/login', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({senha})
    });
    admSenha = senha;
    document.getElementById('adm-login').style.display = 'none';
    document.getElementById('adm-content').style.display = 'block';
    loadRelatorio();
  }catch(e){
    showMsg(msg, 'Erro: ' + e.message, false);
  }
});

// ---------- ADM: relatório ----------
async function loadRelatorio(){
  try{
    const data = await api('/api/relatorio?senha=' + encodeURIComponent(admSenha));
    const statEls = document.querySelectorAll('#adm-stats .stat .num');
    statEls[0].textContent = data.ok;
    statEls[1].textContent = data.perto;
    statEls[2].textContent = data.vencida;

    const total = data.ok + data.perto + data.vencida || 1;
    const bars = [
      {lbl:'OK', val:data.ok, color:'var(--ok)'},
      {lbl:'Perto de vencer', val:data.perto, color:'var(--warn)'},
      {lbl:'Vencida', val:data.vencida, color:'var(--late)'},
    ];
    document.getElementById('adm-bars').innerHTML = bars.map(b=>`
      <div class="bar-row">
        <div class="bar-label"><span>${b.lbl}</span><span>${b.val}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${(b.val/total*100).toFixed(0)}%; background:${b.color}"></div></div>
      </div>`).join('');
  }catch(e){
    console.error(e);
  }
}

// ---------- ADM: atualizar KM ----------
document.getElementById('btn-atualizar-km').addEventListener('click', async ()=>{
  const placa = document.getElementById('a-placa').value.trim().toUpperCase();
  const km = document.getElementById('a-km').value;
  const msg = document.getElementById('msg-atualizar-km');
  const btn = document.getElementById('btn-atualizar-km');
  if(!placa || !km){
    showMsg(msg, 'Preenche placa e KM.', false);
    return;
  }
  btn.disabled = true; btn.textContent = 'Enviando…';
  try{
    await api('/api/atualizar-km', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({placa, km: Number(km), senha: admSenha})
    });
    showMsg(msg, 'KM atualizado.', true);
    document.getElementById('a-placa').value = '';
    document.getElementById('a-km').value = '';
    loadRelatorio();
  }catch(e){
    showMsg(msg, 'Não deu pra atualizar: ' + e.message, false);
  }finally{
    btn.disabled = false; btn.textContent = 'Atualizar';
  }
});
</script>
</body>
</html>
